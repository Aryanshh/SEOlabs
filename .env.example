# PostgreSQL Database URL
# Local PostgreSQL on Linux/VPS:
# DATABASE_URL="postgresql://seolabs_user:yourpassword@localhost:5432/seolabs?schema=public"
#
# Cloud Serverless PostgreSQL (Neon / Supabase / Railway):
# DATABASE_URL="postgresql://user:password@ep-sample-1234.us-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://postgres:password@localhost:5432/seolabs?schema=public"

# NextAuth Authentication Configuration
NEXTAUTH_SECRET="your-secure-nextauth-secret-key-min-32-chars"
NEXTAUTH_URL="https://seolabs.space"
AUTH_SECRET="your-secure-nextauth-secret-key-min-32-chars"

# Google Gemini API Key for AI Pro SEO Analysis
GEMINI_API_KEY=""
